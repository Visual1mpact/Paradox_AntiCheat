{
    "name": "paradox-anticheat",
    "version": "6.8.1",
    "productName": "Paradox-AntiCheat",
    "description": "A utility to fight against malicious hackers on Bedrock Edition",
    "private": true,
    "type": "module",
    "devDependencies": {
        "@types/fs-extra": "11.0.4",
        "@types/node": "26.3.0",
        "7zip-bin-full": "26.2.1",
        "adm-zip": "0.6.0",
        "chalk": "6.0.0",
        "esbuild": "0.28.2",
        "finalhandler": "2.1.1",
        "fs-extra": "11.4.0",
        "glob": "13.0.6",
        "prettier": "3.9.6",
        "puppeteer": "25.9.0",
        "serve-static": "2.2.1",
        "tsc-alias": "1.9.2",
        "typescript": "7.0.2",
        "semver":"7.8.5",
        "javascript-obfuscator": "5.6.0"
    },
    "dependencies": {
        "@minecraft/math": "2.4.0",
        "@minecraft/server": "2.10.0-beta.1.26.44-stable",
        "@minecraft/server-admin": "1.0.0-beta.1.26.44-stable",
        "@minecraft/server-net": "1.0.0-beta.1.26.44-stable",
        "@minecraft/server-ui": "2.2.0-beta.1.26.44-stable",
        "@minecraft/debug-utilities": "1.0.0-beta.1.26.44-stable",
        "crypto-es": "3.1.3"
    },
    "overrides": {
        "@minecraft/math": {
            "@minecraft/server": "2.10.0-beta.1.26.44-stable"
        },
        "@minecraft/server-ui": {
            "@minecraft/server": "2.10.0-beta.1.26.44-stable"
        },
        "@minecraft/server-net": {
            "@minecraft/server": "2.10.0-beta.1.26.44-stable"
        },
        "@minecraft/server-admin": {
            "@minecraft/server": "2.10.0-beta.1.26.44-stable"
        },
        "@minecraft/debug-utilities": {
            "@minecraft/server": "2.10.0-beta.1.26.44-stable"
        }   
    },
    "prettier": {
        "trailingComma": "es5",
        "tabWidth": 4,
        "useTabs": false,
        "semi": true,
        "printWidth": 250
    },
    
    "scripts": {
        "enableMcLoopback": "CheckNetIsolation.exe LoopbackExempt -a -p=S-1-15-2-1958404141-86561845-1752920682-3514627264-368642714-62675701-733520436",
        "enableMcPreviewLoopback": "CheckNetIsolation.exe LoopbackExempt -a -p=S-1-15-2-424268864-5579737-879501358-346833251-474568803-887069379-4040235476",
        "format": "npx prettier --write --ignore-path .prettierignore ./",
        "git-tree": "node bin/git-tree.js",
        "update-bds": "node bin/bds.js",
        "docs": "node bin/server.js",
        "check-naming": "node bin/tree-format.js",
        "build": "npm run check-naming && node bin/build.js --zip",
        "dist": "npm run check-naming && node bin/build.js --zip --mcpack",
        "test": "npm run check-naming && node bin/build.js --zip --server"
    }
}
