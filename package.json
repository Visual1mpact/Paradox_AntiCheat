{
    "name": "paradox-anticheat",
    "version": "5.12.5",
    "productName": "Paradox-AntiCheat",
    "description": "A utility to fight against malicious hackers on Bedrock Edition",
    "private": true,
    "type": "module",
    "devDependencies": {
        "@types/node": "25.3.3",
        "@types/fs-extra": "11.0.4",
        "finalhandler": "2.1.1",
        "prettier": "3.8.1",
        "serve-static": "2.2.1",
        "typescript": "5.9.3",
        "fs-extra": "11.3.3",
        "glob": "13.0.6",
        "adm-zip": "0.5.16",
        "chalk": "5.6.2",
        "tsc-alias": "1.8.16",
        "esbuild": "0.27.3",
        "7zip-bin": "5.2.0",
        "puppeteer": "24.37.5"
    },
    "dependencies": {
        "@minecraft/server-ui": "2.1.0-beta.1.26.3-stable",
        "@minecraft/server": "2.6.0-beta.1.26.3-stable",
        "@minecraft/server-net": "1.0.0-beta.1.26.3-stable",
        "@minecraft/server-admin": "1.0.0-beta.1.26.3-stable",
        "@minecraft/math": "2.4.0",
        "crypto-es": "3.1.3"
    },
    "overrides": {
        "@minecraft/math": {
            "@minecraft/server": "2.6.0-beta.1.26.3-stable"
        },
        "@minecraft/server-ui": {
            "@minecraft/server": "2.6.0-beta.1.26.3-stable"
        },
        "@minecraft/server-net": {
            "@minecraft/server": "2.6.0-beta.1.26.3-stable"
        },
        "@minecraft/server-admin": {
            "@minecraft/server": "2.6.0-beta.1.26.3-stable"
        }
    },
    "prettier": {
        "trailingComma": "es5",
        "tabWidth": 4,
        "useTabs": false,
        "semi": true,
        "printWidth": 250
    },
    "scripts": {
        "postinstall": "npm run copy-modules",
        "copy-modules": "node bin/copy-modules.js",
        "enableMcLoopback": "CheckNetIsolation.exe LoopbackExempt -a -p=S-1-15-2-1958404141-86561845-1752920682-3514627264-368642714-62675701-733520436",
        "enableMcPreviewLoopback": "CheckNetIsolation.exe LoopbackExempt -a -p=S-1-15-2-424268864-5579737-879501358-346833251-474568803-887069379-4040235476",
        "format": "npx prettier --write --ignore-path .prettierignore ./",
        "git-tree": "node bin/git-tree.js",
        "test": "node bin/build.js --server",
        "personal-test": "node bin/build.js --personal --server",
        "check-naming": "node bin/tree-format.js",
        "build": "npm run check-naming && node bin/build.js",
        "dist": "npm run check-naming && node bin/build.js --mcpack --zip",
        "personal-build": "npm run check-naming && node bin/build.js --personal",
        "personal-dist": "npm run check-naming && node bin/build.js --personal --mcpack --zip",
        "pete9xi-build": "npm run check-naming && node bin/build-package.js && node bin/pete9xi-build-package.js"
    }
}
