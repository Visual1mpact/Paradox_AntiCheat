{
  "compilerOptions": {
    "paths": {
      "penrose/*": ["./penrose/*"]
    },

    "rootDir": "./penrose",
    "outDir": "./build/scripts",

    "typeRoots": [
      "./node_modules/@minecraft",
      "./node_modules/@types"
    ],

    "types": ["node", "server", "server-ui", "server-admin"],

    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "ESNext",

    "moduleResolution": "bundler",

    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,

    "allowJs": false,
    "checkJs": false,

    "useDefineForClassFields": true,

    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noImplicitAny": true,
    "alwaysStrict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitThis": true,
    "noUnusedParameters": true
  },

  "include": ["penrose/**/*"],
  "exclude": ["node_modules"]
}
